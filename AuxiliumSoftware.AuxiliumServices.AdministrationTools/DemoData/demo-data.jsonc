    // ----- 1. veterans: compensation scheme appeal (open, busy) -----
    {
      "Ref": "case-gareth-afcs",
      "Title": "Armed Forces Compensation Scheme award appeal",
      "Description": "Gareth was awarded a lower tariff level than expected for a knee injury sustained in service. Reconsideration upheld the original decision; we are supporting an appeal to the First-tier Tribunal (War Pensions and Armed Forces Compensation Chamber).",
      "Status": "Open",
      "Sensitivity": "Confidential",
      "CreatedBy": "manager-rhian",
      "CreatedAt": "-118d",
      "Clients": [ "client-gareth" ],
      "Workers": [ "manager-rhian", "worker-tom" ],
      "AdditionalProperties": [
        {
          "Group": "eligibility",
          "DisplayName": "Service leaver",
          "Content": "Yes, left the Army in 2016"
        },
        {
          "Group": "eligibility",
          "DisplayName": "Income check",
          "Content": "Passed"
        },
        {
          "Group": "referral",
          "DisplayName": "Referred by",
          "Content": "Council Armed Forces Covenant officer"
        },
        {
          "DisplayName": "Tribunal reference",
          "Content": "AFCS/DEMO/00417"
        }
      ],
      "Messages": [
        {
          "From": "client-gareth",
          "Subject": "Reconsideration letter",
          "Content": "Hi, I've had the reconsideration decision back and they've kept it at the same level. Is there anything else we can do?",
          "SentAt": "-60d@18:42"
        },
        {
          "From": "worker-tom",
          "Subject": "Re: Reconsideration letter",
          "Content": "Thanks Gareth. Yes, you can appeal to the tribunal. I'll prepare the appeal form with you. Could you upload the decision letter and any physio reports you have?",
          "SentAt": "-59d@09:15"
        },
        {
          "From": "client-gareth",
          "Subject": "Re: Reconsideration letter",
          "Content": "Uploaded the decision letter. The physio reports are with my GP, I've asked for copies.",
          "SentAt": "-57d@20:03"
        },
        {
          "From": "worker-tom",
          "Subject": "Hearing date confirmed",
          "Content": "Good news, the tribunal has listed the hearing. It's in the calendar for you. We'll have a prep call the week before.",
          "IsUrgent": true,
          "SentAt": "-6d@14:20"
        }
      ],
      "TimelineEntries": [
        {
          "OccurredAt": "-118d@10:00",
          "Title": "Initial appointment",
          "Description": "Took instructions. Client unhappy with tariff level awarded for knee injury."
        },
        {
          "By": "worker-tom",
          "OccurredAt": "-90d@11:30",
          "Title": "Reconsideration requested",
          "Description": "Submitted reconsideration request with client's statement."
        },
        {
          "By": "worker-tom",
          "OccurredAt": "-60d@09:00",
          "Title": "Reconsideration outcome",
          "Description": "Original decision upheld."
        },
        {
          "By": "worker-tom",
          "OccurredAt": "-50d@15:00",
          "Title": "Appeal lodged",
          "Description": "Notice of appeal sent to the tribunal with decision letter attached."
        },
        {
          "By": "worker-tom",
          "OccurredAt": "-6d@14:00",
          "Title": "Hearing listed",
          "Description": "Tribunal hearing listed; client informed."
        }
      ],
      "Todos": [
        {
          "By": "worker-tom",
          "Summary": "Chase GP for physio reports",
          "Priority": "High",
          "Status": "Completed",
          "AssignedTo": "worker-tom",
          "CreatedAt": "-57d",
          "CompletionNote": "Reports received and uploaded."
        },
        {
          "By": "worker-tom",
          "Summary": "Draft submission bundle",
          "Description": "Chronology, medical evidence, client statement.",
          "Priority": "High",
          "Status": "InProgress",
          "AssignedTo": "worker-tom",
          "Due": "+9d",
          "CreatedAt": "-6d"
        },
        {
          "Summary": "Book hearing prep call with Gareth",
          "Priority": "Medium",
          "AssignedTo": "worker-tom",
          "Due": "+12d",
          "CreatedAt": "-6d"
        }
      ]
